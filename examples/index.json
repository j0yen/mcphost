      "name": "chart-in-a-minute",
      "title": "Chart in a minute",
      "summary": "Load a 1,000-row CSV into a table and get a chart with a caption and a share URL from one host.table.chart call.",
      "use_case": [
        "chart"
      ],
      "clients": [
        "any"
      ],
      "since": "0.63.0",
      "proof": "proof.sh",
      "secrets_needed": [],
      "manifest_sha256": "a6bddb1edf43d03f7a2d2db866c307b4afa7a2037d0a4578d1789d68b51ec8af",
      "tools": [],
      "first_call": {
        "tool": "host.table.chart",
        "args": {
          "share": true,
          "sql": "SELECT category, SUM(amount) AS total FROM expenses GROUP BY category"
        },
        "expect": "result.recommendation.mark == bar"
      }
    },
